{
  "name": "openprep-ai-server",
  "version": "1.0.0",
  "description": "Backend API for OpenPrep AI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest run --config vitest.config.unit.js",
    "test:unit": "vitest run --config vitest.config.unit.js",
    "test:jest": "jest --config jest.config.js --runInBand --forceExit",
    "test:coverage": "vitest run --config vitest.config.unit.js --coverage",
    "seed": "node scripts/seed.js",
    "db:migrate:test": "node scripts/migrate.js --force",
    "db:backup": "node scripts/db-backup.js",
    "db:restore": "node scripts/db-restore.js"
  },
