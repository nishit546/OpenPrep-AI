# Every variable below is declared in backend/config/env.js, which validates
# them at startup. Invalid values fail fast in production (all problems are
# reported at once) and warn in development. Values still set to a placeholder
# like `your_..._here` or `changeme` are treated as unset.
#
# "required" below means required when NODE_ENV=production. Development runs
# fine with an empty .env.

# --- Server ---
PORT=5000                      # integer, 1-65535 (default 5000)
NODE_ENV=development           # development | test | production
# LOG_LEVEL=debug              # error | warn | info | debug | silent
# TZ=Asia/Kolkata

# --- PostgreSQL (required in production) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openprep
# DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/openprep_test

# --- Connection pool (optional) ---
# DB_POOL_MAX=10                        # integer, 1-100 (default 10)
# DB_POOL_MIN=0                         # integer, 0-100 (default 0)
# DB_POOL_IDLE=10000                    # ms (default 10000)
# DB_POOL_ACQUIRE=30000                 # ms (default 30000)
# DB_STATEMENT_TIMEOUT=30000            # ms (default 30000)
# DB_IDLE_IN_TRANSACTION_TIMEOUT=30000  # ms (default 30000)

# --- JWT (required in production; must be >= 32 characters there) ---
# Generate one with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=15m
# CSRF_SECRET=                  # secret key used to sign CSRF double-submit cookies
# ENCRYPTION_KEY=                # used to encrypt stored OAuth refresh tokens

# --- CORS / client origin (at least one required in production) ---
# CLIENT_ORIGIN=https://your-app.vercel.app,https://staging.your-app.vercel.app  # Comma-separated whitelist (preferred)
# CLIENT_URL=https://your-app.vercel.app   # Primary frontend URL (must be a valid URL)
# CORS_ORIGIN=http://localhost:5173        # Legacy override; use CLIENT_ORIGIN instead
# Note: *.vercel.app and *.openprep.ai preview URLs are allowed automatically

# --- OAuth / Frontend URL (optional -- defaults to http://localhost:5173) ---
# FRONTEND_URL is the redirect target after OAuth & email verification.
# In production, this MUST be your Vercel frontend URL (e.g. https://open-prep-6to0ylqm4-nishit-doshis-projects.vercel.app)
# FRONTEND_URL=http://localhost:5173

# Google OAuth requires BOTH ID and SECRET in production.
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# The callback URL must match exactly what is configured in Google Cloud Console.
# In production, this MUST be absolute (e.g. https://openprep-ai.onrender.com/api/auth/google/callback)
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
# In production, this MUST be absolute (e.g. https://openprep-ai.onrender.com/api/auth/github/callback)
# GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# --- Redis (optional -- falls back to DB-only when unreachable) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Gemini API (optional -- falls back to mock data) ---
# GEMINI_API_KEY=your_gemini_api_key_here

# --- SMTP / Email (optional -- falls back to console in dev) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587          # integer, 1-65535 (default 587)
# SMTP_SECURE=false      # boolean: true/false, 1/0, yes/no, on/off
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="OpenPrep AI <noreply@openprep.ai>"

# --- Web Push Notifications (optional -- embedded dev keys are used as fallback) ---
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_SUBJECT=mailto:admin@openprep-ai.com

# --- Caching (optional) ---
# CACHE_ENABLED=true     # enable/disable Redis caching (default true)
# CACHE_TTL=3600         # seconds (default 3600)
# CACHE_MAX_KEYS=1000    # integer, >= 1 (default 1000)

# --- OCR (optional) ---
# OCR_TIMEOUT_MS=60000   # milliseconds (default 60000, min 1000)
# --- File upload limits (optional) ---
# MAX_AUDIO_UPLOAD_SIZE_MB=25    # integer, 1-500 (default 25)

# --- Misc (optional) ---
# AWS_REGION=ap-south-1

# --- Storage (optional -- defaults to local filesystem) ---
# STORAGE_PROVIDER=local               # local | s3 (default: local)
# AWS_S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_PUBLIC_BASE_URL=https://your-bucket.s3.amazonaws.com

# --- Testing (optional -- only relevant when NODE_ENV=test) ---
# ENABLE_RATE_LIMIT_TESTS=true

# --- Sentry (optional) ---
# SENTRY_DSN=your_sentry_dsn_here
# SENTRY_ENVIRONMENT=production

# --- Slow query profiler / index advisor (optional, see #2193) ---
# SLOW_QUERY_THRESHOLD_MS=100
# INDEX_ADVISOR_ROW_THRESHOLD=10000
# QUERY_PROFILER_EXPLAIN_TIMEOUT_MS=5000
# DISABLE_QUERY_PROFILER=false